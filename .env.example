# Copy to .env and adjust for your deployment.
ROADMAP_BIND_ADDRESS=127.0.0.1
ROADMAP_PORT=8000

# For direct public HTTP access, set ROADMAP_BIND_ADDRESS=0.0.0.0 and
# ROADMAP_ALLOWED_HOSTS=YOUR_PUBLIC_IP:YOUR_PORT.
# Browser clients that send Origin also need their exact origin allowed.
ROADMAP_ALLOWED_HOSTS=
ROADMAP_ALLOWED_ORIGINS=
